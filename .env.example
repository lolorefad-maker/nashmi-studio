# ===== Server =====
PORT=3000
APP_NAME=Nashmi Studio
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ===== Platform owner (admin) — created on first run =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Seed a demo client with 12 months of sample data (true/false)
SEED_DEMO=true

# ===== AI model (OpenAI-compatible /chat/completions) =====
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_IMAGE_MODEL=

# Public https address of the app, e.g. https://studio.example.com
PUBLIC_URL=
# Optional separate key for encrypting stored store/social credentials (defaults to JWT_SECRET)
ENCRYPTION_KEY=

META_APP_ID=
META_APP_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE=
WA_TEMPLATE_LANG=ar

# Nano Banana image generation (Google AI Studio key; billing must be enabled for image models)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-3-flash-preview
